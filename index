import tkinter as tk
from tkinter import messagebox # 팝업창
from tkinter import filedialog # 폴더 선택 창을 위한 tkinter 하위 모듈
from pathlib import Path       # 파일 경로/확장자 다루기
import shutil                  # 파일 이동

#기능구현 - 김별, 장나경
# 1. 정리할 폴더를 선택하는 함수(김별)
def select_folder():
    selected_path = filedialog.askdirectory() # 폴더 선택 창을 열고  선택한 폴더 경로를 문자열로 가져옴
    if selected_path: #사용자가 실제로 폴더를 선택했을 때만 입력창 갱신
        entry_path.delete(0, tk.END)          # 기존 입력창 비우기
        entry_path.insert(0, selected_path)   # insert(0, 값)으로 값을 채움


# 2. 실제로 파일을 분석하고 분류하는 함수(김별)
def classify_files(folder_path):
    path = Path(folder_path)   # 문자열 경로를 경로 객체로 변환
    summary = {} # 확장자별 개수를 저장할 딕셔너리 예){.jpg:3}

    # 폴더 안의 모든 파일/폴더를 하나씩 꺼내며 item에 담아 반복
    for item in path.iterdir():
        # 폴더가 아닌 진짜 파일인지 확인
        if item.is_file():
            ext = item.suffix.lower() # 확장자만 추출 (소문자로 통일)

            if ext == "":
                ext = ".unknown"# 확장자가 없는 파일 처리

            target_folder = path / ext# 이동할 폴더 경로 생성
            target_folder.mkdir(exist_ok=True) # 폴더가 없으면 새로 생성
            shutil.move(str(item), str(target_folder))  # 파일 이동

            # 확장자별 개수 세기
            if ext in summary:
                summary[ext] += 1 #이미 있던 확장자면 개수 +1
            else:
                summary[ext] = 1 #처음 나온 확장자면 1로 시작

    return summary #최종 분류 결과 딕셔너리를 돌려줌


# 3. 분류 시작 버튼을 눌렀을 때 실행되는 함수(장나경)
def start_sorting():
    folder_path = entry_path.get()   # Entry에 입력된 경로 가져오기

    # 아무것도 선택하지 않았을 때 경고창 띄우기
    if folder_path == "":
        messagebox.showwarning("경고", "정리할 폴더를 먼저 선택해주세요!")
        return

    # 폴더 접근 중 오류가 나도 프로그램이 꺼지지 않도록 방지
    try:
        result_data = classify_files(folder_path) #실제 분류 작업 실행 후 결과 받아옴
        #수정이 안되므로 수정할 수 있는 상태로 잠시 바꿔야함
        text_result.config(state="normal") # Text 수정 가능 상태로 변경
        text_result.delete("1.0", "end") # Text 내용 지우기
    #분류된 파일이 하나도 없는 경우
        if not result_data:
            text_result.insert(tk.END, "분류할 파일이 폴더 안에 없습니다.\n")
        else:
           #분류 결과가 있는 경우 딕셔너리를 하나씩 꺼내서 줄바꿈해 출력
            text_result.insert(tk.END, "[분류 완료 결과]\n\n")
            for ext, count in result_data.items():
                text_result.insert(tk.END, f"{ext} 폴더 : {count}개 파일 이동 완료\n")

        text_result.config(state="disabled") # 출력이 끝나면 다시 결과 수정하지 못하게 함
        messagebox.showinfo("완료", "파일 자동 분류가 성공적으로 끝났습니다!")

    except Exception as e:
        messagebox.showwarning("오류", f"프로그램 실행 중 오류가 발생했습니다:\n{e}")


# UI 디자인 영역-현다연, 김보민

# 창 만들기 & 설정 (현다연, 김보민)
window = tk.Tk()
window.title("확장자별 파일 자동 분류 프로그램")#창 제목
window.geometry("500x450") #크기
window.configure(bg="#FFF0F5")     # 배경색 설정(핑크)
window.resizable(False, False)     # 창 크기 조절 비활성화

# 제목 Label
title = tk.Label(window, text="🌸 파일 자동 분류 프로그램", font=("한컴산뜻돋움", 16, "bold"), bg="#FFF0F5", fg="#FF1493")
title.pack(pady=20) #위 아래 여백

# 폴더 선택 영역을 묶는 Frame
input_frame = tk.Frame(window, bg="#FFF0F5")
input_frame.pack(fill="x", padx=20, pady=10)

lbl_dir = tk.Label(input_frame, text="대상 폴더:", font=("한컴산뜻돋움", 11), bg="#FFF0F5")
lbl_dir.pack(side="left", padx=5)

# 경로를 보여줄 Entry 입력창
entry_path = tk.Entry(input_frame, font=("Arial", 10), width=35)
entry_path.pack(side="left", padx=5, expand=True, fill="x")

# 찾아보기 버튼 클릭 시 select_folder() 함수 실행
btn_browse = tk.Button(input_frame, text="찾아보기", font=("한컴산뜻돋움", 9, "bold"), command=select_folder, bg="#FFD1DC")
btn_browse.pack(side="left", padx=5)

# 자동 분류 시작버튼 클릭 시 start_sorting()함수 실행
btn_start = tk.Button(window, text="⚡자동 분류 시작 ⚡", font=("한컴산뜻돋움", 12, "bold"), bg="#FF69B4", fg="white", command=start_sorting)
btn_start.pack(pady=15, fill="x", padx=20)

card = tk.Frame(window, bg="#FFFFFF")
card.pack(fill="both", expand=True, padx=20, pady=(10, 25))
#결과 영역 안내 문구
lbl_result = tk.Label(card, text="[분류 결과 안내]", font=("한컴산뜻돋움", 10, "bold"), bg="#FFFFFF", fg="#7A7A8C")
lbl_result.pack(anchor="w", padx=15, pady=(10, 5))

# 분류 결과를 출력할 위젯
text_result = tk.Text(card, font=("한컴산뜻돋움", 11), bg="#FFF5F7", height=10)
text_result.pack(fill="both", expand=True, padx=15, pady=(0, 15))
text_result.insert("1.0", "상단의 [찾아보기] 버튼을 눌러 정리할 폴더를 선택해주세요.")
text_result.config(state="disabled")   # 처음부터 읽기 전용으로 설정

window.mainloop()
